#!/bin/sh
set -e

case "$1" in
    remove|upgrade|deconfigure)
        # A running screensaver holding the screen while its binary is
        # replaced is the one failure mode worth pre-empting here.
        if command -v pkill >/dev/null 2>&1; then
            pkill -x matrisaver || true
        fi
        ;;
    failed-upgrade)
        ;;
    *)
        echo "prerm called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

exit 0
