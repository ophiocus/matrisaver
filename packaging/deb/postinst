#!/bin/sh
set -e

case "$1" in
    configure)
        if command -v update-desktop-database >/dev/null 2>&1; then
            update-desktop-database -q /usr/share/applications || true
        fi
        # systemd user units are not enabled from maintainer scripts:
        # enabling is per-user and needs a running user manager. Tell the
        # admin instead of guessing.
        if [ -z "${2:-}" ]; then
            cat <<'EOF'
MatriSaver installed.

  Try it:                 matrisaver --window
  Fullscreen playback:    matrisaver --run
  Idle integration:       systemctl --user enable --now matrisaver-idle.service
  Details:                /usr/share/doc/matrisaver/README.Debian

MatriSaver is a screensaver, not a screen locker — keep your desktop's
own lock in charge of locking.
EOF
        fi
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

exit 0
